# Порт сервера
PORT=3000

# Секретный ключ для JWT - ОБЯЗАТЕЛЬНО поменяй в production!
# Сгенерируй свой: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Ключ Anthropic API для анализа кода через Claude
# Получить: https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Модель Claude для анализа. Проверь актуальные ID на docs.claude.com
# и поставь ту, что доступна твоему аккаунту.
CLAUDE_MODEL=claude-sonnet-4-5

NODE_ENV=production
